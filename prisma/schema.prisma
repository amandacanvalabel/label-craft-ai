generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  SUBSCRIBER
}

enum PlanType {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  LIFETIME
}

enum PaymentMethod {
  PIX
  BOLETO
  CARD
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum AIProvider {
  GROK
  DALLE
  MIDJOURNEY
  LEONARDO
}

enum CouponType {
  PERCENT
  FIXED
}

enum PaymentKind {
  SUBSCRIPTION
  CREDIT_PACKAGE
}

enum AnnouncementVariant {
  INFO
  SUCCESS
  WARNING
  PROMO
}

enum TeamRole {
  ADMIN
  MEMBER
}

enum TeamStatus {
  PENDING
  ACTIVE
}

enum TicketStatus {
  AI
  HUMAN
  RESOLVED
}

enum SupportRole {
  USER
  ASSISTANT
  AGENT
}

// ==================== MODELS ====================

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model SiteSettings {
  id                String   @id @default("site")
  siteName          String   @default("CanvaLabel")
  siteTagline       String   @default("Crie rótulos profissionais com IA")
  logoHeaderUrl     String?
  logoFooterUrl     String?
  faviconUrl        String?
  openGraphImageUrl String?
  metaTitle         String   @default("CanvaLabel — Crie rótulos profissionais com IA")
  metaDescription   String   @default("Plataforma inteligente para criação de rótulos e etiquetas em conformidade com a ANVISA. Geração com IA, editor visual e exportação para gráficas.")
  canonicalUrl      String   @default("https://canvalabel.com.br")
  keywords          String[] @default(["rótulos", "etiquetas", "ANVISA", "IA", "inteligência artificial", "editor visual"])
  maintenanceMode   Boolean  @default(false)
  twoFactorEnabled  Boolean  @default(false)
  sessionTimeoutDays Int     @default(7)
  defaultTheme      String   @default("system")
  primaryColor      String   @default("#2563eb")
  accentColor       String   @default("#0ea5e9")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("site_settings")
}

model Subscriber {
  id           String   @id @default(cuid())
  cpfOrCnpj    String   @unique
  name         String
  email        String   @unique
  password     String
  avatar       String?
  phone        String?
  street       String?
  number       String?
  neighborhood String?
  city         String?
  state        String?
  country      String   @default("Brasil")
  asaasCustomerId String? @unique

  planId    String?
  plan      Plan?    @relation(fields: [planId], references: [id])

  // Identidade visual da marca (todos os planos)
  brandName   String?
  brandLogo   String?
  brandColors String[] @default([])

  // Uso e créditos (cobrança avançada)
  aiCreditsUsed     Int      @default(0)  // gerações de IA usadas no ciclo
  imageCreditsUsed  Int      @default(0)  // gerações de imagem usadas no ciclo
  extraAiCredits    Int      @default(0)  // créditos avulsos comprados (não expiram no ciclo)
  extraImageCredits Int      @default(0)
  usagePeriodStart  DateTime @default(now()) // início do ciclo de uso (reset mensal)

  payments  Payment[]
  models    SubscriberModel[]
  folders   Folder[]
  teamMembersOwned TeamMember[] @relation("TeamOwner")
  teamMemberships  TeamMember[] @relation("TeamMembership")
  supportTickets   SupportTicket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscribers")
}

model SupportTicket {
  id      String       @id @default(cuid())
  subject String
  status  TicketStatus @default(AI)

  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  messages SupportMessage[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  @@map("support_tickets")
}

model SupportMessage {
  id             String      @id @default(cuid())
  role           SupportRole
  content        String
  attachmentUrl  String?
  attachmentName String?
  readByUser     Boolean     @default(true) // false = resposta (IA/atendente) ainda não vista

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("support_messages")
}

model TeamMember {
  id      String @id @default(cuid())
  email   String
  role    TeamRole   @default(MEMBER)
  status  TeamStatus @default(PENDING)

  ownerId String
  owner   Subscriber @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  memberId String?
  member   Subscriber? @relation("TeamMembership", fields: [memberId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@unique([ownerId, email])
  @@map("team_members")
}

model Folder {
  id           String   @id @default(cuid())
  name         String
  color        String   @default("#2563eb")

  parentId String?
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderTree")

  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  models SubscriberModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("folders")
}

model Plan {
  id               String   @id @default(cuid())
  name             String
  description      String?
  benefits         String[]
  type             PlanType
  price            Float
  promotionalPrice Float?
  isActive         Boolean  @default(true)

  // Limites mensais (-1 = ilimitado)
  monthlyAiCredits    Int @default(50)
  monthlyImageCredits Int @default(10)
  maxLabels           Int @default(20)
  storageMb           Int @default(100)

  subscribers Subscriber[]
  payments    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model Payment {
  id              String        @id @default(cuid())
  amount          Float
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  kind            PaymentKind   @default(SUBSCRIPTION)
  asaasPaymentId  String?       @unique
  asaasInvoiceUrl String?

  couponCode     String?
  creditsApplied Boolean @default(false) // pacote: créditos já lançados ao subscriber?

  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  creditPackageId String?
  creditPackage   CreditPackage? @relation(fields: [creditPackageId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model CreditPackage {
  id           String   @id @default(cuid())
  name         String
  description  String?
  aiCredits    Int      @default(0)
  imageCredits Int      @default(0)
  price        Float
  isActive     Boolean  @default(true)

  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("credit_packages")
}

model Coupon {
  id         String     @id @default(cuid())
  code       String     @unique
  type       CouponType @default(PERCENT)
  value      Float      // PERCENT: 0-100; FIXED: valor em R$
  isActive   Boolean    @default(true)
  maxUses    Int?       // null = ilimitado
  usedCount  Int        @default(0)
  minAmount  Float?     // valor mínimo da compra para aplicar
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("coupons")
}

model SiteMetrics {
  id             String   @id @default(cuid())
  clicks         Int      @default(0)
  views          Int      @default(0)
  uniqueVisitors Int      @default(0)
  pageViews      Int      @default(0)
  bounceRate     Float    @default(0)
  date           DateTime @unique @default(now())
  createdAt      DateTime @default(now())

  @@map("site_metrics")
}

model AIModel {
  id       String     @id @default(cuid())
  name     String
  provider AIProvider
  apiKey   String
  baseUrl  String?
  isActive Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_models")
}

model SubscriberModel {
  id         String @id @default(cuid())
  name       String
  thumbnail  String?
  canvasData Json

  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscriber_models")
}

model Announcement {
  id        String              @id @default(cuid())
  title     String
  message   String
  variant   AnnouncementVariant @default(INFO)
  linkUrl   String?
  linkLabel String?
  isActive  Boolean             @default(true)
  startsAt  DateTime?
  endsAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}

model Template {
  id         String   @id @default(cuid())
  name       String
  category   String
  thumbnail  String?
  background String?
  width      Int
  height     Int
  colors     String[]
  fonts      String[]
  canvasData Json
  isPublic   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("templates")
}
